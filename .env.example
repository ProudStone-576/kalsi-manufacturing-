# Copy to .env.local (development) or set in your host's secret store (production).
# Never commit real values.

# Public origin of the site, used for canonical URLs, sitemap and the CSRF origin check.
SITE_URL=https://www.example.com

# Mail transport: "smtp" (production) or "file" (writes .eml files to DATA_DIR/outbox; development/testing).
# Defaults: smtp when NODE_ENV=production, otherwise file.
MAIL_TRANSPORT=smtp

# SMTP (required when MAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS, required by the app)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Envelope sender (must be a mailbox your SMTP provider lets you send as)
MAIL_FROM="S.S. Kalsi Industries Website <no-reply@example.com>"
# Where enquiries are delivered (comma-separated for several inboxes)
ENQUIRY_TO=sales@example.com

# Where enquiry records and uploaded drawings are kept (outside the web root). Must be writable.
DATA_DIR=./data

# Set to "true" only when the app runs behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# Enquiries allowed per IP per window (defaults: 8 per 600 seconds)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=600
